                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Delete Document",
        "description": "Delete a document and its associated file\n\n- **document_id**: UUID of the document to delete\n\nPermanently removes the document record and file from storage.\nReturns 204 No Content on successful deletion.",
        "operationId": "delete_document_api_v1_documents__document_id__delete",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "OAuth2": [
              "read:documents",
              "write:documents",
              "delete:documents"
            ]
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Documents"
        ],
        "summary": "Update Document Metadata",
        "description": "Update document metadata (for external services)\n\nThis endpoint allows external AI services to update document metadata after processing.\nIt supports updating the following fields:\n\n- **file_type**: Document classification (cv or jd)\n- **text_content**: Extracted text content from the document\n- **role**: Identified job role or position (e.g., \"Python Developer\")\n- **features**: List of extracted features (skills, certifications, etc.)\n- **metadata**: Additional metadata fields\n\n## Request Body\n\nAll fields are optional - only provide the fields you want to update:\n\n```json\n{\n    \"file_type\": \"cv\",\n    \"text_content\": \"John Doe\\nSoftware Engineer\\n...\",\n    \"role\": \"Python Developer\",\n    \"features\": [\n        {\n            \"name\": \"Python\",\n            \"type\": \"skill\",\n            \"properties\": {\"years\": 5, \"level\": \"expert\"}\n        },\n        {\n            \"name\": \"AWS Solutions Architect\",\n            \"type\": \"certification\",\n            \"properties\": {\"grade\": \"A\", \"year_obtained\": 2023}\n        }\n    ],\n    \"metadata\": {\n        \"processing_version\": \"1.2.0\",\n        \"confidence_score\": 0.95\n    }\n}\n```\n\n## Features Structure\n\nFeatures support flexible NoSQL structure with:\n- **name**: Feature/skill name\n- **type**: Feature type (skill, certification, language, tool, etc.)\n- **properties**: Flexible key-value properties specific to the feature type\n\n## Authentication\n\n- Requires valid JWT token\n- Only authorized external services can update documents\n- Users can only update their own documents\n\n## Events\n\n- Publishes `document.updated` event to Azure Service Bus after successful update\n- Event contains complete updated document data for AI matching service\n\n## Response\n\nReturns success status and updated document ID on successful update.",
        "operationId": "update_document_metadata_api_v1_documents__document_id__put",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "OAuth2": [
              "read:documents",
              "write:documents",
              "delete:documents"
            ]
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{document_id}/download": {
      "get": {
        "tags": [
          "Documents",
          "Documents"
        ],
        "summary": "Download Document File",
        "description": "Download the original document file as uploaded by the user",
        "operationId": "download_document_api_v1_documents__document_id__download_get",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "OAuth2": [
              "read:documents",
              "write:documents",
              "delete:documents"
            ]
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document file downloaded successfully",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/pdf": {
                "example": "Binary PDF content"
              },
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
                "example": "Binary DOCX content"
              },
              "application/msword": {
                "example": "Binary DOC content"
              }
            },
            "headers": {
              "Content-Disposition": {
                "description": "Attachment with original filename",
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename=resume.pdf"
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Not authenticated"
                }
              }
            }
          },
          "404": {
            "description": "Document not found or access denied",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": {
                    "code": "DOCUMENT_NOT_FOUND",
                    "message": "Document not found"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during download",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": {
                    "code": "DOWNLOAD_FAILED",
                    "message": "Failed to download document"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
